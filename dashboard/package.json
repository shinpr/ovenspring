{
  "name": "ovenspring-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run tokens:check && pnpm run type-check && vite build",
    "tokens": "node tokens/build.ts",
    "tokens:check": "node tokens/build.ts --check",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --error-on-warnings --write .",
    "check:unused": "knip",
    "test": "vitest run",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "check:all": "pnpm run check && pnpm run format:check && pnpm run check:unused && pnpm run build && pnpm run test && pnpm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "markdown-to-jsx": "9.10.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "knip": "^6.45.1",
    "playwright": "^1.65.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
